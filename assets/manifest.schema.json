{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/amework/asset-manifest.schema.json",
  "title": "AmeWork asset manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy", "slots"],
  "properties": {
    "schema_version": { "const": "1.2" },
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["code_license_applies_to_assets", "public_browser_delivery_is_redistribution", "default_renderer", "use_scope"],
      "properties": {
        "code_license_applies_to_assets": { "const": false },
        "public_browser_delivery_is_redistribution": { "const": true },
        "default_renderer": { "const": "licensed_glb_with_static_fallback" },
        "use_scope": { "const": "local_noncommercial_fan_project" }
      }
    },
    "slots": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "$ref": "#/$defs/slot" } }
  },
  "$defs": {
    "localizedText": { "type": "object", "additionalProperties": false, "required": ["en", "es"], "properties": { "en": { "type": "string", "minLength": 1 }, "es": { "type": "string", "minLength": 1 } } },
    "asset": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "runtime_uri", "original_filename", "format", "bytes", "sha256", "generator", "unmodified_copy", "animation_clips"],
      "properties": {
        "path": { "type": "string", "pattern": "^frontend/public/models/[a-z-]+\\.glb$" },
        "runtime_uri": { "type": "string", "pattern": "^/models/[a-z-]+\\.glb$" },
        "original_filename": { "type": "string", "minLength": 1 }, "format": { "const": "glb" },
        "bytes": { "type": "integer", "minimum": 1 }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "generator": { "type": "string", "minLength": 1 }, "unmodified_copy": { "const": true },
        "animation_clips": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "animation_duration_seconds": { "type": "number", "minimum": 0 }
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["author_or_rightsholder", "original_source_url", "license_name_and_version", "license_text_or_permalink", "retrieval_date", "proof_of_acquisition", "attribution_text", "permission_to_modify", "permission_to_redistribute_browser_downloadable_glb", "mesh_texture_rig_animation_provenance", "conversion_log", "trademark_and_likeness_review"],
      "properties": {
        "author_or_rightsholder": { "type": "string", "minLength": 1 },
        "original_source_url": { "type": "string", "format": "uri" }, "license_name_and_version": { "const": "CC BY 4.0" },
        "license_text_or_permalink": { "const": "https://creativecommons.org/licenses/by/4.0/" }, "retrieval_date": { "type": "string", "format": "date" },
        "proof_of_acquisition": { "type": "string", "minLength": 1 }, "attribution_text": { "type": "string", "minLength": 1 },
        "permission_to_modify": { "const": true }, "permission_to_redistribute_browser_downloadable_glb": { "const": "allowed_with_attribution" },
        "mesh_texture_rig_animation_provenance": { "type": "string", "minLength": 1 }, "conversion_log": { "type": "string", "minLength": 1 },
        "trademark_and_likeness_review": { "type": "string", "minLength": 1 }
      }
    },
    "slot": {
      "type": "object", "additionalProperties": false,
      "required": ["slot_id", "agent_id", "role", "requested_identity", "status", "publishable", "asset", "license_gate", "fallback"],
      "properties": {
        "slot_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }, "agent_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "role": { "$ref": "#/$defs/localizedText" },
        "requested_identity": { "type": "object", "additionalProperties": false, "required": ["name", "group", "mapping_scope"], "properties": { "name": { "type": "string", "minLength": 1 }, "group": { "const": "hololive English -Myth-" }, "mapping_scope": { "const": "visual_orchestrator_only" } } },
        "status": { "const": "included_local_noncommercial" }, "publishable": { "const": true }, "asset": { "$ref": "#/$defs/asset" },
        "license_gate": { "type": "object", "additionalProperties": false, "required": ["evidence", "required_fields"], "properties": { "evidence": { "$ref": "#/$defs/evidence" }, "required_fields": { "type": "array", "minItems": 12, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } } } },
        "fallback": { "type": "object", "additionalProperties": false, "required": ["kind", "path", "runtime_uri"], "properties": { "kind": { "const": "static_svg" }, "path": { "type": "string" }, "runtime_uri": { "type": "string" } } }
      }
    }
  }
}
