{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workspace asset manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "policy", "scene", "supporting_assets"],
  "properties": {
    "$schema": { "const": "./manifest.schema.json" },
    "schema_version": { "const": "2.0" },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default_renderer", "public_browser_delivery_is_redistribution", "external_visual_or_audio_assets"],
      "properties": {
        "default_renderer": { "const": "procedural_scene_with_static_fallback" },
        "public_browser_delivery_is_redistribution": { "const": true },
        "external_visual_or_audio_assets": { "const": false }
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scene_id", "source_path", "kind", "provenance"],
      "properties": {
        "scene_id": { "const": "professional_workspace" },
        "source_path": { "const": "frontend/src/components/DeskScene.tsx" },
        "kind": { "const": "procedural_geometry" },
        "provenance": { "type": "string", "minLength": 1 }
      }
    },
    "supporting_assets": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/image" }
    }
  },
  "$defs": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "kind", "path", "runtime_uri", "format", "provenance"],
      "properties": {
        "asset_id": { "enum": ["workspace_mark", "desk_fallback"] },
        "kind": { "const": "image" },
        "path": { "type": "string", "pattern": "^frontend/public/branding/[a-z-]+\\.svg$" },
        "runtime_uri": { "type": "string", "pattern": "^/branding/[a-z-]+\\.svg$" },
        "format": { "const": "svg" },
        "provenance": { "type": "string", "minLength": 1 }
      }
    }
  }
}
