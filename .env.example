# Local service only. Never bind the production profile to 0.0.0.0.
JOB_ORCHESTRATOR_HOST=127.0.0.1
JOB_ORCHESTRATOR_PORT=8765
JOB_ORCHESTRATOR_DATA_DIR=./data
JOB_ORCHESTRATOR_ARTIFACT_DIR=./artifacts
JOB_ORCHESTRATOR_SESSION_TOKEN=

# DeepSeek credentials are entered in the UI and stored in the operating-system
# credential vault. Docker may inject DEEPSEEK_API_KEY or DEEPSEEK_API_KEY_FILE.
JOB_ORCHESTRATOR_DEEPSEEK_BASE_URL=https://api.deepseek.com
JOB_ORCHESTRATOR_DEEPSEEK_MODEL=deepseek-v4-pro
JOB_ORCHESTRATOR_DEEPSEEK_REASONING_EFFORT=high
JOB_ORCHESTRATOR_DEEPSEEK_MAX_CONCURRENCY=1
JOB_ORCHESTRATOR_REQUEST_TIMEOUT_SECONDS=120
JOB_ORCHESTRATOR_MAX_CONNECTOR_RESULTS=2000

# TheirStack credentials are entered separately and stored in the operating-system
# credential vault. Docker may inject THEIRSTACK_API_KEY or THEIRSTACK_API_KEY_FILE.
# Each returned job can consume one TheirStack credit.
JOB_ORCHESTRATOR_THEIRSTACK_BASE_URL=https://api.theirstack.com
JOB_ORCHESTRATOR_THEIRSTACK_BATCH_SIZE=20

# Optional corporate ATS boards. Format: source:identifier. Only Greenhouse,
# Lever, and Ashby are accepted; new searches use a strict seven-day window.
JOB_ORCHESTRATOR_CAREER_ATS_BOARDS=[]

# Disable optional telemetry by default.
DO_NOT_TRACK=1

# Frontend development proxy.
VITE_API_BASE_URL=
VITE_SESSION_TOKEN=
